# =============================================================================
# MapIt Backend API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# =============================================================================
# JWT Authentication Configuration
# =============================================================================
# IMPORTANT: Generate a secure secret key. This must match the webapp's JWT_SECRET_KEY
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-generated-jwt-secret-key-here

# Optional: Static API key for simple authentication
# STATIC_API_KEY=your-static-api-key-here

# =============================================================================
# AI Provider Configuration
# =============================================================================
# OpenAI API Key (for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (recommended for cost efficiency)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (for access to multiple models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default AI provider to use (openai, gemini, or openrouter)
DEFAULT_AI_PROVIDER=gemini

# =============================================================================
# Model Configuration
# =============================================================================
OPENAI_MODEL=gpt-4-turbo
GEMINI_MODEL=gemini-flash-lite-latest
OPENROUTER_MODEL=x-ai/grok-4-fast:free

# =============================================================================
# Google Embedding API Configuration
# =============================================================================
# Used for vector embeddings
GOOGLE_EMBEDDING_API_KEY=your_google_embedding_api_key_here
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# =============================================================================
# Database Configuration (Legacy CORDIS)
# =============================================================================
USE_LOCAL_DB=false
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=50

# =============================================================================
# CORDIS Data Source Configuration
# =============================================================================
CORDIS_SOURCE=local
CORDIS_API_URL=https://cordis.europa.eu/api/search/results
CORDIS_API_TIMEOUT=30

# =============================================================================
# Supabase Configuration (Vector Database)
# =============================================================================
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
USE_SUPABASE=true

# =============================================================================
# Vector Search Configuration
# =============================================================================
VECTOR_SEARCH_ENABLED=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_QUERY=5
SIMILARITY_THRESHOLD=0.7

# =============================================================================
# Document Processing Configuration
# =============================================================================
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
SUPPORTED_FILE_TYPES=[".pdf", ".txt", ".md", ".html"]

# =============================================================================
# Redis Configuration (for caching and Celery)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Task Limits
# =============================================================================
TASK_TIME_LIMIT=300
TASK_SOFT_TIME_LIMIT=240

# =============================================================================
# Docker Configuration
# =============================================================================
DOCKER_ENV=false

# =============================================================================
# CORS Configuration
# =============================================================================
# Allowed origins for API access
CORS_ORIGINS=["*"]

# =============================================================================
# Analytics Configuration (Optional)
# =============================================================================
# Enable conversation analytics logging
ENABLE_ANALYTICS=true

# =============================================================================
# Generating a JWT Secret
# =============================================================================
# To generate a secure JWT secret, run:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# IMPORTANT: Use the SAME secret in both this .env file AND the webapp's .env
