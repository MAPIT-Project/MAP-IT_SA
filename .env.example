# =====================================================================================================================
# Docker Compose Environment Variable Precedence
# =====================================================================================================================
#
# When running with Docker Compose, some variables in this file are OVERRIDDEN
# by docker-compose.yml because they need to use Docker service names.
#
# Precedence (highest to lowest):
#   1. Hardcoded values in docker-compose.yml (e.g., FOO=value) ← WINS
#   2. Shell environment variables
#   3. This .env file
#   4. Defaults in docker-compose.yml (e.g., ${FOO:-default})
#
# Variables OVERRIDDEN by docker-compose.yml (Docker-specific):
#   - REDIS_URL, REDIS_HOST, REDIS_PORT (uses 'redis' service)
#   - DATABASE_URL (uses 'supabase_db_supabase_cli' service)
#   - SUPABASE_URL (uses 'supabase_kong_supabase_cli' service)
#   - NEO4J_URI (uses 'neo4j' service)
#   - DOCKER_ENV (set to 'true')
#
# Variables RESPECTED from this .env file:
#   - All API keys (OPENAI_API_KEY, GEMINI_API_KEY, etc.)
#   - Model configuration (OPENAI_MODEL, GEMINI_MODEL, etc.)
#   - Embedding settings (EMBEDDING_MODEL, EMBEDDING_DIMENSION)
#   - Vector search settings (CHUNK_SIZE, CHUNK_OVERLAP, etc.)
#
# =====================================================================================================================

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# AI Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_AI_PROVIDER=gemini

# Model Configuration
OPENAI_MODEL=gpt-4-turbo
GEMINI_MODEL=gemini-3-flash-preview #cheaper model for simple queries
GEMINI_PRO_MODEL=gemini-3.1-pro-preview #more powerful model for complex queries
OPENROUTER_MODEL=x-ai/grok-4-fast:free
SMART_MODEL_ROUTING=true #enable smart model routing for complex queries

# Google Embedding API Configuration
GOOGLE_EMBEDDING_API_KEY=your_google_embedding_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# Database Configuration (Required)
# Note: Overridden by docker-compose.yml when running in Docker (uses supabase_db service)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=50

# EU Portal API Configuration
# Used by app/services/call_enrichment_service.py for fetching call details
EU_PORTAL_BASE_URL=https://api.tech.ec.europa.eu/search-api/prod/rest/search
EU_PORTAL_TOPIC_DETAILS_URL=https://ec.europa.eu/info/funding-tenders/opportunities/data/topicDetails
EU_PORTAL_FACET_URL=https://api.tech.ec.europa.eu/search-api/prod/rest/facet

# Call Enrichment Service Configuration
CALL_ENRICHMENT_MAX_RETRIES=3
CALL_ENRICHMENT_BASE_DELAY=1.0
CALL_ENRICHMENT_MAX_DELAY=30.0
CALL_ENRICHMENT_EXPONENTIAL_BASE=2.0
CALL_ENRICHMENT_CACHE_TTL=3600

# Enhanced Call Search Configuration
ENHANCED_CALL_SEARCH_CACHE_TTL=3600

# Similar Projects Tool Configuration
EMBEDDING_TIMEOUT=30.0
VECTOR_SEARCH_TIMEOUT=10.0
GRAPH_CONTEXT_TIMEOUT=30.0

# Query Processing Configuration
LONG_QUERY_THRESHOLD=500
MAX_PROCESSED_QUERY_LENGTH=400

# Supabase Configuration (Required)
# Note: SUPABASE_URL overridden by docker-compose.yml when running in Docker (uses supabase_kong service)
# For local development, use your Supabase project URL
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Vector Search Configuration
VECTOR_SEARCH_ENABLED=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=300
MAX_CHUNKS_PER_QUERY=20
SIMILARITY_THRESHOLD=0.45

# Document Processing Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
SUPPORTED_FILE_TYPES=[".pdf", ".txt", ".md", ".html"]

# Neo4j Configuration
# Note: Overridden by docker-compose.yml when running in Docker (uses neo4j service)
NEO4J_URI=your_neo4j_uri_here #bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mapit_secure_password_2024

# Celery Configuration (optional)
# Note: Redis URLs overridden by docker-compose.yml when running in Docker (uses redis service)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
TASK_TIME_LIMIT=300
TASK_SOFT_TIME_LIMIT=240
REDIS_HOST=redis
REDIS_PORT=6379

# Docker Configuration
# Note: DOCKER_ENV is automatically set to 'true' by docker-compose.yml
# You don't need to set this manually
# DOCKER_ENV=false

# CORS Configuration
CORS_ORIGINS=["*"]
