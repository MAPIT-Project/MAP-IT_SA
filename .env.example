# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# AI Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_AI_PROVIDER=gemini

# Model Configuration
OPENAI_MODEL=gpt-4-turbo
GEMINI_MODEL=gemini-2.0-flash-thinking-exp

# Google Embedding API Configuration
GOOGLE_EMBEDDING_API_KEY=your_google_embedding_api_key_here
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# Database Configuration (Legacy CORDIS)
USE_LOCAL_DB=false
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=50

# Supabase Configuration (New Vector Database)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
USE_SUPABASE=true

# Vector Search Configuration
VECTOR_SEARCH_ENABLED=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_QUERY=5
SIMILARITY_THRESHOLD=0.7

# Document Processing Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
SUPPORTED_FILE_TYPES=[".pdf", ".txt", ".md", ".html"]

# Celery Configuration (optional)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Task Limits
TASK_TIME_LIMIT=300
TASK_SOFT_TIME_LIMIT=240

# Docker Configuration
DOCKER_ENV=false

# CORS Configuration
CORS_ORIGINS=["*"]